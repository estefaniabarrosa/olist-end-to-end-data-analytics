    <worksheet name='Top Product Categories at Customer Experience Risk'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Highest-Risk Product Categories</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_category_satisfaction' name='federated.1n9kzjf0r4bwo31bft8du096veie' />
          </datasources>
          <datasource-dependencies datasource='federated.1n9kzjf0r4bwo31bft8du096veie'>
            <column caption='Risk Rank' datatype='integer' name='[Calculation_1320552337268738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(AVG([negative_review_rate]), &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Average Review Score' datatype='real' name='[average_review_score]' role='measure' type='quantitative' />
            <column-instance column='[negative_review_rate]' derivation='Avg' name='[avg:negative_review_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[reviewed_orders]' derivation='Avg' name='[avg:reviewed_orders:qk]' pivot='key' type='quantitative' />
            <column caption='Negative Review Rate' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[negative_review_rate]' role='measure' type='quantitative' />
            <column-instance column='[product_category]' derivation='None' name='[none:product_category:nk]' pivot='key' type='nominal' />
            <column caption='Product Category' datatype='string' name='[product_category]' role='dimension' type='nominal'>
              <aliases>
