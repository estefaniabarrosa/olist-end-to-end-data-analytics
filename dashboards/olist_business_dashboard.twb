    <worksheet name='Seller Performance Concentration'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Seller Performance Concentration</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_items_clean' name='federated.0ejejpx0ilzvyb1f9g2d81isfjv6' />
          </datasources>
          <datasource-dependencies datasource='federated.0ejejpx0ilzvyb1f9g2d81isfjv6'>
            <column caption='Seller GMV' datatype='real' name='[Calculation_1320552340951043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [seller_id] : SUM([price]) }' />
            </column>
            <column caption='% Cumulative Sellers' datatype='real' default-format='p0.0%' name='[Calculation_1320552342200324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX() / SIZE()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Cumulative GMV' datatype='real' default-format='p0.0%' name='[Calculation_1320552342298629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1320552340951043]))&#13;&#10;/&#13;&#10;WINDOW_SUM(SUM([Calculation_1320552340951043]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[seller_id]' derivation='None' name='[none:seller_id:nk]' pivot='key' type='nominal' />
            <column caption='Price' datatype='real' name='[price]' role='measure' type='quantitative' />
            <column caption='Seller Id' datatype='string' name='[seller_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1320552340951043]' derivation='Sum' name='[sum:Calculation_1320552340951043:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1320552342200324]' derivation='User' name='[usr:Calculation_1320552342200324:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0ejejpx0ilzvyb1f9g2d81isfjv6].[seller_id]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_1320552342298629]' derivation='User' name='[usr:Calculation_1320552342298629:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0ejejpx0ilzvyb1f9g2d81isfjv6].[seller_id]' ordering-type='Field' />
            </column-instance>
          </datasource-dependencies>
