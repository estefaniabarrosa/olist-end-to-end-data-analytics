              </aliases>
            </column>
            <column caption='Reviewed Orders' datatype='integer' name='[reviewed_orders]' role='measure' type='quantitative' />
            <column-instance column='[average_review_score]' derivation='Sum' name='[sum:average_review_score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[reviewed_orders]' derivation='Sum' name='[sum:reviewed_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1320552337268738]' derivation='User' name='[usr:Calculation_1320552337268738:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
